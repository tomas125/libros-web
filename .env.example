# Copiar a .env.local y completar. Nunca subir .env.local al repo.

# Origen de datos: sqlite (local, pruebas) | supabase (producción, export estático)
NEXT_PUBLIC_DATA_PROVIDER=sqlite

# Admin local (modo sqlite). Elegí tus propios valores en .env.local.
ADMIN_USER=admin
ADMIN_PASSWORD=elegi-una-clave-de-prueba
# Opcional: secreto para firmar la cookie de sesión (si falta, se deriva de la contraseña)
ADMIN_SECRET=

# Supabase (modo supabase)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# URL pública del sitio (sitemap, SEO)
NEXT_PUBLIC_SITE_URL=https://entrepaginas.com.ar
